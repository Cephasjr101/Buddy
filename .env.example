# Core
SHOP_SECRET=change-me-long-random-string
BASE_URL=https://your-app.fly.dev
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=changeme123

# AI brain (optional - without it a built-in intent parser is used)
OPENAI_API_KEY=

# Voice: local VoiceStudio (https://github.com/debpalash/VoiceStudio)
# Clone it on your server/VPS (heavy GPU model) and point to its install dir,
# or run it on the same machine. Leave blank to disable local voice.
VOICESTUDIO_DIR=
VOICESTUDIO_PYTHON=python

# Calls (https://www.twilio.com) - without these, calls queue as tasks
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# WhatsApp Business Cloud API (Meta) - for inbound voice notes & alerts
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Social posting (Meta Graph API page tokens)
FACEBOOK_PAGE_TOKEN=
INSTAGRAM_BUSINESS_ID=

# Email sending (SMTP)
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
